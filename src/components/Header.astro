---
import Logo from './Logo.astro';
import { contactNav, mainNav } from '../data/site';

const current = Astro.url.pathname;
const isCurrent = (href: string) => current.startsWith(href);
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="トップページへ">
      <span class="site-header__logo-light"><Logo /></span>
      <span class="site-header__logo-dark" aria-hidden="true"><Logo onDark /></span>
    </a>

    <nav class="site-header__nav" aria-label="メインメニュー">
      <ul class="nav-list">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <span class="nav-link__en">{item.labelEn}</span>
                <span class="nav-link__ja">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href={contactNav.href} class="nav-contact">
        {contactNav.label}
      </a>
    </nav>

    <button
      type="button"
      class="menu-button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <span class="visually-hidden" data-menu-label>メニューを開く</span>
      <span class="menu-button__bar" aria-hidden="true"></span>
      <span class="menu-button__bar" aria-hidden="true"></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="mobile-menu__inner" aria-label="メインメニュー">
      <ul>
        <li>
          <a href="/" class="mobile-link">
            <span class="mobile-link__en">Top</span>
            <span class="mobile-link__ja">トップ</span>
          </a>
        </li>
        {
          [...mainNav, contactNav].map((item) => (
            <li>
              <a
                href={item.href}
                class="mobile-link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <span class="mobile-link__en">{item.labelEn}</span>
                <span class="mobile-link__ja">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  // スクロールしたらヘッダーに背景をつける
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  // 濃い色のセクション（data-header-dark）に重なっている間は、ヘッダーを濃紺仕様にする
  if (header && 'IntersectionObserver' in window) {
    const darkSections = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) darkSections.add(entry.target);
          else darkSections.delete(entry.target);
        });
        header.toggleAttribute('data-on-dark', darkSections.size > 0);
      },
      // 画面の一番上（ヘッダーの高さ程度）だけを判定に使う
      { rootMargin: '0px 0px -92% 0px' },
    );
    document.querySelectorAll('[data-header-dark]').forEach((el) => observer.observe(el));
  }

  // スマホ用メニューの開閉
  if (button && menu && label) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'メニューを閉じる' : 'メニューを開く';
      menu.hidden = !open;
      document.documentElement.classList.toggle('is-menu-open', open);
    };

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        button.focus();
      }
    });

    // PC幅に戻ったら閉じる
    window.matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition:
      background-color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .site-header[data-scrolled] {
    background: rgb(246 249 252 / 0.92);
    box-shadow: 0 1px 0 rgb(14 23 38 / 0.06);
  }

  @supports (backdrop-filter: blur(1px)) {
    .site-header[data-scrolled],
    .site-header[data-on-dark] {
      background: rgb(246 249 252 / 0.78);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
  }

  .site-header__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    padding-inline: var(--gutter);
  }

  .site-header__logo {
    display: flex;
    align-items: center;
  }

  .site-header__logo-dark {
    display: none;
  }

  /* ---- 濃紺セクションの上にいるとき ---- */
  .site-header[data-on-dark] {
    background: rgb(10 26 51 / 0.78);
    box-shadow: none;
    color: var(--color-white);
  }

  .site-header[data-on-dark] .site-header__logo-light {
    display: none;
  }

  .site-header[data-on-dark] .site-header__logo-dark {
    display: block;
  }

  .site-header[data-on-dark] .nav-link__ja {
    color: rgb(255 255 255 / 0.6);
  }

  .site-header[data-on-dark] .nav-link::after {
    background: var(--color-horizon);
  }

  .site-header[data-on-dark] .nav-contact {
    background: var(--color-white);
    color: var(--color-deep-navy);
  }

  .site-header[data-on-dark] .nav-contact:hover {
    background: var(--color-mist);
  }

  .site-header[data-on-dark] .menu-button__bar {
    background: var(--color-white);
  }

  /* メニューを開いている間は常に白背景の仕様 */
  :global(html.is-menu-open) .site-header {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  :global(html.is-menu-open) .site-header .site-header__logo-light {
    display: block;
  }

  :global(html.is-menu-open) .site-header .site-header__logo-dark {
    display: none;
  }

  :global(html.is-menu-open) .site-header .menu-button__bar {
    background: var(--color-deep-navy);
  }

  /* ---- PC ---- */
  .site-header__nav {
    display: none;
  }

  @media (min-width: 900px) {
    .site-header__nav {
      display: flex;
      align-items: center;
      gap: 40px;
    }

    .menu-button {
      display: none;
    }
  }

  .nav-list {
    display: flex;
    gap: 36px;
  }

  .nav-link {
    position: relative;
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    padding-block: 6px;
  }

  .nav-link__en {
    font-family: var(--font-en);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .nav-link__ja {
    font-size: 0.65rem;
    color: var(--color-slate);
    letter-spacing: 0.1em;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--color-blue);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-out);
  }

  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-contact {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding-inline: 1.5em;
    border-radius: 999px;
    background: var(--color-deep-navy);
    color: var(--color-white);
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    transition: background-color 0.4s var(--ease-out);
  }

  .nav-contact:hover {
    background: var(--color-blue);
  }

  /* ---- スマホ ---- */
  .menu-button {
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .menu-button__bar {
    position: absolute;
    left: 10px;
    width: 24px;
    height: 1.5px;
    background: var(--color-deep-navy);
    transition: transform 0.4s var(--ease-out);
  }

  .menu-button__bar:nth-of-type(1) {
    top: 17px;
  }

  .menu-button__bar:nth-of-type(2) {
    top: 26px;
  }

  .menu-button[aria-expanded='true'] .menu-button__bar:nth-of-type(1) {
    transform: translateY(4.5px) rotate(45deg);
  }

  .menu-button[aria-expanded='true'] .menu-button__bar:nth-of-type(2) {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow-y: auto;
    background: var(--color-paper);
    padding: calc(var(--header-height) + 32px) var(--gutter) 48px;
  }

  .mobile-menu__inner ul {
    display: grid;
    border-top: 1px solid rgb(14 23 38 / 0.1);
  }

  .mobile-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
    border-bottom: 1px solid rgb(14 23 38 / 0.1);
  }

  .mobile-link__en {
    font-family: var(--font-en);
    font-size: 1.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .mobile-link__ja {
    font-size: var(--fs-small);
    color: var(--color-slate);
  }

  .mobile-link[aria-current='page'] .mobile-link__en {
    color: var(--color-blue);
  }

  :global(html.is-menu-open) {
    overflow: hidden;
  }
</style>
