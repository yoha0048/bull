---
import Logo from './Logo.astro';
import { company } from '../data/company';
import { contactNav, mainNav, privacyNav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-header-dark>
  <div class="site-footer__line" aria-hidden="true"></div>
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" aria-label="トップページへ">
        <Logo onDark />
      </a>
      <p class="site-footer__tagline">{site.tagline}</p>
      <p class="site-footer__tagline-en">{site.taglineEn}</p>
    </div>

    <nav class="site-footer__nav" aria-label="フッターメニュー">
      <ul>
        <li><a href="/">Top</a></li>
        {
          [...mainNav, contactNav].map((item) => (
            <li>
              <a href={item.href}>{item.labelEn}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-footer__company">
      <p class="site-footer__name">{company.name}</p>
      <p>{company.address}</p>
    </div>
  </div>

  <div class="container">
    <div class="site-footer__bottom">
      <a href={privacyNav.href}>{privacyNav.label}</a>
      <small>&copy; {year} {company.name}</small>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--color-deep-navy);
    color: var(--color-white);
    padding-block: clamp(72px, 10vw, 120px) 32px;
  }

  /* 画面の外へ抜けていく水平線 */
  .site-footer__line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--gradient-horizon);
    opacity: 0.8;
  }

  .site-footer__inner {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .site-footer__inner {
      grid-template-columns: 1.4fr 1fr 1fr;
      align-items: start;
    }
  }

  .site-footer__tagline {
    margin-top: 28px;
    font-size: var(--fs-small);
    font-weight: 500;
  }

  .site-footer__tagline-en {
    font-family: var(--font-en);
    font-size: var(--fs-small);
    color: var(--color-horizon);
    letter-spacing: 0.02em;
  }

  .site-footer__nav ul {
    display: grid;
    gap: 12px;
  }

  .site-footer__nav a {
    font-family: var(--font-en);
    font-size: 1.1rem;
    font-weight: 500;
    transition: color 0.3s;
  }

  .site-footer__nav a:hover {
    color: var(--color-horizon);
  }

  .site-footer__company {
    font-size: var(--fs-small);
    color: rgb(255 255 255 / 0.72);
  }

  .site-footer__name {
    color: var(--color-white);
    font-weight: 700;
    margin-bottom: 4px;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: clamp(56px, 8vw, 96px);
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    font-size: var(--fs-label);
    color: rgb(255 255 255 / 0.6);
  }

  .site-footer__bottom a:hover {
    color: var(--color-white);
  }

  .site-footer__bottom small {
    font-size: inherit;
  }
</style>
