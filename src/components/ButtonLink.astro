---
/** 矢印付きのボタン型リンク */
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'light';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
---

<a href={href} class:list={['button', `button--${variant}`, className]}>
  <span class="button__text"><slot /></span>
  <span class="button__arrow" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
  </span>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 1.25em;
    min-height: 56px;
    padding: 0.9em 1.1em 0.9em 1.8em;
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.4;
    transition:
      background-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out);
  }

  .button__arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 50%;
    transition: transform var(--duration) var(--ease-out);
  }

  .button:hover .button__arrow {
    transform: translateX(4px);
  }

  .button--primary {
    background: var(--color-blue);
    color: var(--color-white);
  }

  .button--primary .button__arrow {
    background: var(--color-white);
    color: var(--color-blue);
  }

  .button--primary:hover {
    background: var(--color-deep-navy);
  }

  .button--outline {
    border: 1px solid var(--color-deep-navy);
    color: var(--color-deep-navy);
  }

  .button--outline .button__arrow {
    background: var(--color-deep-navy);
    color: var(--color-white);
  }

  .button--outline:hover {
    background: var(--color-deep-navy);
    color: var(--color-white);
  }

  .button--outline:hover .button__arrow {
    background: var(--color-white);
    color: var(--color-deep-navy);
  }

  .button--light {
    background: var(--color-white);
    color: var(--color-deep-navy);
  }

  .button--light .button__arrow {
    background: var(--color-blue);
    color: var(--color-white);
  }

  .button--light:hover {
    background: var(--color-mist);
  }
</style>
