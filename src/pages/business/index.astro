---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCta from '../../components/ContactCta.astro';
import { approach, businessHero, domains, domainsIntro, together } from '../../data/business';

const pad = (n: number) => String(n).padStart(2, '0');
const domainById = Object.fromEntries(domains.map((d) => [d.id, d]));

/*
 * 考え方の図：左の4つ（人・企業・サービス・市場）が bull で結ばれ、右へ伸びて画面の外へ抜ける。
 * PC用（横）とスマホ用（縦）の2種類を用意し、CSSで切り替える。
 */
const center = { x: 640, y: 230 };
const inputsPc = approach.inputs.map((input, i) => ({ ...input, x: 230, y: 65 + i * 110 }));
const curvePc = (x: number, y: number) => {
  const dx = (center.x - x) * 0.55;
  return `M${x} ${y} C${x + dx} ${y} ${center.x - dx} ${center.y} ${center.x} ${center.y}`;
};

const centerSp = { x: 180, y: 300 };
const inputsSp = approach.inputs.map((input, i) => ({ ...input, x: 45 + i * 90, y: 92 }));
const curveSp = (x: number, y: number) => {
  const dy = (centerSp.y - y) * 0.55;
  return `M${x} ${y} C${x} ${y + dy} ${centerSp.x} ${centerSp.y - dy} ${centerSp.x} ${centerSp.y}`;
};
---

<BaseLayout
  title="事業紹介"
  description="株式会社bullの事業紹介。営業支援・営業代行、販路拡大支援、海外展開・国際ビジネス支援、ビジネスマッチング・ネットワーク支援。人・企業・サービス・市場をつなぎ、ビジネスを前に進めます。"
>
  <PageHero labelEn={businessHero.labelEn} title={businessHero.title} lead={businessHero.lead} />

  <!-- ========== Approach：ひとつの考え方 ========== -->
  <section class="approach" aria-labelledby="approach-heading" data-header-dark>
    <div class="container">
      <div class="approach__text">
        <p class="label approach__label" data-fade>{approach.label}</p>
        <h2 id="approach-heading" class="approach__heading" data-fade>
          {approach.heading.map((line) => <span class="approach__heading-line">{line}</span>)}
        </h2>
        <div class="approach__body" data-fade style="--fade-delay:0.1s">
          {approach.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>

    <figure class="approach__figure" data-fade>
      <figcaption class="visually-hidden">
        人・企業・サービス・市場がbullを通じてつながり、ビジネスが動き出すことを表した図
      </figcaption>

      <!-- PC用 -->
      <svg class="diagram diagram--pc" viewBox="0 0 1200 460" aria-hidden="true" focusable="false">
        {
          inputsPc.map((n, i) => (
            <path class="diagram__line" d={curvePc(n.x, n.y)} pathLength="1" style={`--d:${i * 0.12}s`} />
          ))
        }
        <path class="diagram__line diagram__line--out" d={`M${center.x} ${center.y} H1260`} pathLength="1" style="--d:0.7s" />
        <path class="diagram__flow" d={`M${center.x + 60} ${center.y} H1260`} />
        {
          inputsPc.map((n) => (
            <g class="diagram__input">
              <circle class="diagram__halo" cx={n.x} cy={n.y} r="14" />
              <circle class="diagram__node" cx={n.x} cy={n.y} r="5" />
              <text class="diagram__en" x={n.x - 28} y={n.y - 2} text-anchor="end">
                {n.en}
              </text>
              <text class="diagram__ja" x={n.x - 28} y={n.y + 20} text-anchor="end">
                {n.ja}
              </text>
            </g>
          ))
        }
        <circle class="diagram__core-halo" cx={center.x} cy={center.y} r="64" />
        <circle class="diagram__core" cx={center.x} cy={center.y} r="46" />
        <text class="diagram__core-text" x={center.x} y={center.y + 8} text-anchor="middle">bull</text>
        <text class="diagram__out-en" x="860" y={center.y - 22}>{approach.output.en}</text>
        <text class="diagram__out-ja" x="860" y={center.y + 38}>{approach.output.ja}</text>
      </svg>

      <!-- スマホ用 -->
      <svg class="diagram diagram--sp" viewBox="0 0 360 620" aria-hidden="true" focusable="false">
        {
          inputsSp.map((n, i) => (
            <path class="diagram__line" d={curveSp(n.x, n.y)} pathLength="1" style={`--d:${i * 0.12}s`} />
          ))
        }
        <path class="diagram__line diagram__line--out" d={`M${centerSp.x} ${centerSp.y} V660`} pathLength="1" style="--d:0.7s" />
        <path class="diagram__flow" d={`M${centerSp.x} ${centerSp.y + 50} V660`} />
        {
          inputsSp.map((n) => (
            <g class="diagram__input">
              <text class="diagram__ja" x={n.x} y={n.y - 46} text-anchor="middle">
                {n.ja}
              </text>
              <text class="diagram__en diagram__en--sm" x={n.x} y={n.y - 26} text-anchor="middle">
                {n.en}
              </text>
              <circle class="diagram__halo" cx={n.x} cy={n.y} r="12" />
              <circle class="diagram__node" cx={n.x} cy={n.y} r="4.5" />
            </g>
          ))
        }
        <circle class="diagram__core-halo" cx={centerSp.x} cy={centerSp.y} r="52" />
        <circle class="diagram__core" cx={centerSp.x} cy={centerSp.y} r="38" />
        <text class="diagram__core-text" x={centerSp.x} y={centerSp.y + 7} text-anchor="middle">bull</text>
        <text class="diagram__out-en diagram__out-en--sm" x={centerSp.x - 18} y="460" text-anchor="end">{approach.output.en}</text>
        <text class="diagram__out-ja diagram__out-ja--sm" x={centerSp.x - 18} y="486" text-anchor="end">{approach.output.ja}</text>
      </svg>
    </figure>
  </section>

  <!-- ========== 4つの事業 ========== -->
  <section class="domains" aria-labelledby="domains-heading">
    <div class="container">
      <p class="label" data-fade>{domainsIntro.label}</p>
      <h2 id="domains-heading" class="domains__heading" data-fade>{domainsIntro.heading}</h2>
      <p class="domains__lead" data-fade>{domainsIntro.lead}</p>

      <nav class="domains__nav" aria-label="事業一覧" data-fade>
        <ul>
          {
            domains.map((d, i) => (
              <li>
                <a href={`#${d.id}`}>
                  <span class="domains__nav-num">{pad(i + 1)}</span>
                  <span class="domains__nav-en">{d.en}</span>
                  <span class="domains__nav-ja">{d.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="domains__list">
      {
        domains.map((d, i) => (
          <article class="domain" id={d.id} aria-labelledby={`${d.id}-name`}>
            <div class="domain__rule" aria-hidden="true">
              <span class="domain__rule-dot" />
            </div>
            <div class="container domain__inner">
              <header class="domain__head" data-fade>
                <p class="domain__num">{pad(i + 1)}</p>
                <p class="domain__en" lang="en">
                  {d.en}
                </p>
                <h3 class="domain__name" id={`${d.id}-name`}>
                  {d.name}
                </h3>
                <p class="domain__copy">{d.copy}</p>
              </header>

              <div class="domain__body">
                <p class="domain__summary" data-fade>
                  {d.summary}
                </p>

                <div class="domain__blocks">
                  <section class="domain__block domain__block--concern" data-fade>
                    <h4 class="domain__block-title">こんなお悩みに</h4>
                    <ul class="concerns">
                      {d.concerns.map((c) => (
                        <li>{c}</li>
                      ))}
                    </ul>
                  </section>

                  <section class="domain__block" data-fade style="--fade-delay:0.1s">
                    <h4 class="domain__block-title">bullの関わり方</h4>
                    <ol class="steps">
                      {d.approach.map((a) => (
                        <li>{a}</li>
                      ))}
                    </ol>
                  </section>
                </div>

                <p class="domain__related" data-fade>
                  <span class="domain__related-label">あわせて関わる事業</span>
                  {d.related.map((id) => (
                    <a href={`#${id}`} class="domain__related-link">
                      <span lang="en">{domainById[id].en}</span>
                      <span class="domain__related-ja">{domainById[id].name}</span>
                    </a>
                  ))}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ========== 事業はつながっている ========== -->
  <section class="together" aria-labelledby="together-heading">
    <div class="container together__inner">
      <div>
        <p class="label" data-fade>{together.label}</p>
        <h2 id="together-heading" class="together__heading" data-fade>
          {together.heading.map((line) => <span class="together__heading-line">{line}</span>)}
        </h2>
      </div>
      <div class="together__body" data-fade style="--fade-delay:0.1s">
        {together.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>

<style>
  /* =========================================================
     Approach
     ========================================================= */
  .approach {
    overflow: hidden;
    padding-block: var(--section-space) clamp(64px, 10vw, 140px);
    background: var(--color-deep-navy);
    color: var(--color-white);
  }

  .approach__label {
    color: var(--color-horizon);
  }

  .approach__heading {
    margin-top: 24px;
    font-size: var(--fs-h1);
    line-height: 1.3;
  }

  .approach__heading-line {
    display: block;
  }

  .approach__body {
    display: grid;
    gap: 1.2em;
    max-width: 40em;
    margin-top: clamp(28px, 4vw, 44px);
    font-size: var(--fs-lead);
    line-height: 2;
    color: rgb(255 255 255 / 0.78);
  }

  .approach__figure {
    margin-top: clamp(48px, 7vw, 96px);
  }

  .diagram {
    width: 100%;
    max-width: none;
    overflow: visible;
  }

  .diagram--pc {
    display: none;
  }

  .diagram--sp {
    max-width: 420px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  @media (min-width: 768px) {
    .diagram--pc {
      display: block;
    }

    .diagram--sp {
      display: none;
    }
  }

  .diagram__line {
    fill: none;
    stroke: var(--color-horizon);
    stroke-width: 1.5;
  }

  .diagram__flow {
    fill: none;
    stroke: var(--color-white);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 2 26;
    opacity: 0.7;
  }

  .diagram__halo {
    fill: var(--color-horizon);
    opacity: 0.2;
  }

  .diagram__node {
    fill: var(--color-white);
  }

  .diagram__en {
    fill: var(--color-white);
    font-family: var(--font-en);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .diagram__en--sm {
    fill: var(--color-horizon);
    font-size: 10px;
    font-weight: 500;
  }

  .diagram__ja {
    fill: rgb(255 255 255 / 0.62);
    font-family: var(--font-ja);
    font-size: 14px;
  }

  .diagram--sp .diagram__ja {
    fill: var(--color-white);
    font-size: 15px;
    font-weight: 700;
  }

  .diagram__core-halo {
    fill: var(--color-blue);
    opacity: 0.25;
  }

  .diagram__core {
    fill: var(--color-blue);
  }

  .diagram__core-text {
    fill: var(--color-white);
    font-family: var(--font-en);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .diagram--sp .diagram__core-text {
    font-size: 22px;
  }

  .diagram__out-en {
    fill: var(--color-white);
    font-family: var(--font-en);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .diagram__out-en--sm {
    font-size: 18px;
  }

  .diagram__out-ja {
    fill: var(--color-horizon);
    font-family: var(--font-ja);
    font-size: 16px;
    font-weight: 500;
  }

  .diagram__out-ja--sm {
    font-size: 13px;
  }

  /* 図が画面に入ったら線を描く */
  :global(.fade-ready) .approach__figure .diagram__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.4s var(--ease-out) var(--d, 0s);
  }

  :global(.fade-ready) .approach__figure.is-in .diagram__line {
    stroke-dashoffset: 0;
  }

  :global(.motion-ok) .diagram__flow {
    animation: diagram-flow 1.6s linear infinite;
  }

  @keyframes diagram-flow {
    to {
      stroke-dashoffset: -28;
    }
  }

  /* =========================================================
     4つの事業
     ========================================================= */
  .domains {
    padding-block: var(--section-space) 0;
    background: var(--color-paper);
  }

  .domains__heading {
    margin-top: 24px;
    font-size: var(--fs-h2);
  }

  .domains__lead {
    margin-top: 20px;
    font-size: var(--fs-lead);
    color: var(--color-slate);
  }

  .domains__nav {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .domains__nav ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (min-width: 1024px) {
    .domains__nav ul {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .domains__nav a {
    display: grid;
    gap: 2px;
    height: 100%;
    padding: 18px 20px;
    border: 1px solid rgb(14 23 38 / 0.1);
    border-radius: 12px;
    background: var(--color-white);
    transition:
      border-color 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .domains__nav a:hover {
    border-color: var(--color-blue);
    transform: translateY(-2px);
  }

  .domains__nav-num {
    font-family: var(--font-en);
    font-size: var(--fs-label);
    color: var(--color-slate);
  }

  .domains__nav-en {
    font-family: var(--font-en);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-blue);
  }

  .domains__nav-ja {
    font-size: var(--fs-label);
    line-height: 1.6;
    color: var(--color-slate);
  }

  .domains__list {
    margin-top: clamp(72px, 10vw, 140px);
  }

  .domain {
    position: relative;
    padding-block: clamp(56px, 7vw, 96px);
    scroll-margin-top: var(--header-height);
  }

  .domain:nth-child(even) {
    background: var(--color-white);
  }

  /* 各事業の上を通る、画面の外まで続く線 */
  .domain__rule {
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-blue), var(--color-horizon) 50%, var(--color-mist));
  }

  @media (min-width: 1328px) {
    .domain__rule {
      left: calc((100vw - var(--container)) / 2);
    }
  }

  .domain__rule-dot {
    position: absolute;
    top: -5px;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-blue);
    box-shadow: 0 0 0 6px rgb(36 86 240 / 0.12);
  }

  .domain__inner {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 1024px) {
    .domain__inner {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }

    .domain__head {
      position: sticky;
      top: calc(var(--header-height) + 40px);
    }
  }

  .domain__num {
    font-family: var(--font-en);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--color-slate);
  }

  .domain__en {
    margin-top: 8px;
    font-family: var(--font-en);
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-blue);
  }

  .domain__name {
    margin-top: 20px;
    font-size: var(--fs-h3);
  }

  .domain__copy {
    margin-top: 12px;
    font-size: var(--fs-lead);
    font-weight: 500;
    color: var(--color-slate);
  }

  .domain__summary {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 2;
  }

  .domain__blocks {
    display: grid;
    gap: 20px;
    margin-top: 32px;
  }

  @media (min-width: 768px) {
    .domain__blocks {
      grid-template-columns: 1fr 1fr;
    }
  }

  .domain__block {
    padding: 28px 28px 32px;
    border-radius: 16px;
    background: var(--color-white);
    border: 1px solid rgb(14 23 38 / 0.08);
  }

  .domain:nth-child(even) .domain__block {
    background: var(--color-paper);
  }

  .domain__block--concern {
    background: var(--color-mist) !important;
    border-color: transparent;
  }

  .domain__block-title {
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-blue);
  }

  .concerns {
    display: grid;
    gap: 14px;
    margin-top: 18px;
  }

  .concerns li {
    position: relative;
    padding-left: 1.2em;
    font-weight: 500;
    line-height: 1.8;
  }

  .concerns li::before {
    content: '“';
    position: absolute;
    left: 0;
    top: -0.1em;
    font-family: var(--font-en);
    font-size: 1.4em;
    font-weight: 600;
    color: var(--color-blue);
  }

  /* 点と線でつながる箇条書き */
  .steps {
    position: relative;
    display: grid;
    gap: 16px;
    margin-top: 18px;
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 0.9em;
    bottom: 0.9em;
    left: 4px;
    width: 1px;
    background: var(--color-horizon);
  }

  .steps li {
    position: relative;
    padding-left: 26px;
    font-size: var(--fs-small);
    line-height: 1.9;
  }

  .steps li::before {
    content: '';
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-blue);
  }

  .domain__related {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    margin-top: 28px;
  }

  .domain__related-label {
    margin-right: 8px;
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-slate);
  }

  .domain__related-link {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgb(36 86 240 / 0.3);
    font-family: var(--font-en);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-blue);
    transition:
      background-color 0.3s,
      color 0.3s;
  }

  .domain__related-ja {
    font-family: var(--font-ja);
    font-size: var(--fs-label);
    font-weight: 500;
  }

  .domain__related-link:hover {
    background: var(--color-blue);
    color: var(--color-white);
  }

  /* =========================================================
     Together
     ========================================================= */
  .together {
    padding-block: var(--section-space);
    background: var(--color-paper);
    border-top: 1px solid rgb(14 23 38 / 0.06);
  }

  .together__inner {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 1024px) {
    .together__inner {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
    }
  }

  .together__heading {
    margin-top: 24px;
    font-size: var(--fs-h2);
    line-height: 1.5;
  }

  .together__heading-line {
    display: block;
  }

  .together__body {
    display: grid;
    gap: 1.2em;
    font-size: var(--fs-lead);
    line-height: 2.1;
  }

  .together__body p:last-child {
    font-weight: 700;
    color: var(--color-blue);
  }

  @media (min-width: 1024px) {
    .together__body {
      padding-top: 52px;
    }
  }
</style>
